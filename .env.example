# ─────────────────────────────────────────────────────────────
# ⚠️ OJO: ESTE ARCHIVO SÍ SE PUBLICA EN INTERNET. Es solo la PLANTILLA.
#    NUNCA pegues claves reales aquí.
#
#    Tus claves reales van en:  .env.local   ← ese está protegido
# ─────────────────────────────────────────────────────────────

# ── Supabase (la base de datos y las cuentas de tus alumnas) ──
# Panel de Supabase → tu proyecto → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxx          # SECRETA — solo servidor, nunca en el navegador

# ── Hotmart (el aviso automático cuando alguien compra) ──────
# Panel de Hotmart → Herramientas → Webhook → tu hottok
HOTMART_HOTTOK=

# ── Videos del curso ─────────────────────────────────────────
# Los videos NO salen de Hotmart: su reproductor solo funciona dentro de Hotmart Club.
# Solo hace falta si eliges Bunny Stream (con Vimeo o YouTube se deja vacío).
# Panel de Bunny → Stream → tu Video Library → el número que sale en la URL
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
# Bunny → Video Library → Security → "Token Authentication Key".
# SECRETA. Con ella el enlace del video caduca en 6 horas y no sirve para compartir el curso.
BUNNY_TOKEN_KEY=

# ── Avisos push (que la app le avise a la alumna) ────────────
# Se generan una sola vez con:  npx web-push generate-vapid-keys
# ⚠️ Si se cambian, TODAS las alumnas suscritas dejan de recibir avisos.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@tudominio.com

# ── El Ojo Experto (la inteligencia artificial) ──────────────
# Google AI Studio → aistudio.google.com/apikey → "Create API key"
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_DAILY_BUDGET_USD=5                        # respaldo: se usa si faltan los dos de abajo

# Topes diarios SEPARADOS por público (migración 0011). Si se agota el de la
# cortesía, el de las alumnas sigue intacto: alguien con acceso de regalo no
# puede dejar sin Ojo Experto a quien está pagando.
# Medido: ~USD 0,0018 por consulta → 2 USD ≈ 1.100 consultas/día de cortesía,
# 8 USD ≈ 4.400 de alumnas (500 alumnas activas gastan ~1,20 USD/día).
# ⚠️ Son DOS cubos: el gasto máximo del día es la SUMA de los dos.
AI_DAILY_BUDGET_REGALO_USD=2
AI_DAILY_BUDGET_MIEMBRO_USD=8

# ── Correos que manda la APP (Resend) ────────────────────────
# resend.com → API Keys. ⚠️ OJO: esta clave es para los correos que envía nuestro
# código (el de bienvenida tras la compra). El correo de ACCESO (magic link) lo
# manda Supabase, y para eso la MISMA clave se pega en el panel de Supabase
# (Authentication → SMTP Settings), NO aquí.
RESEND_API_KEY=
# Desde qué dirección salen. El dominio tiene que estar verificado en Resend.
RESEND_FROM="Manos Creadoras <hola@tudominio.com>"

# ── Modo simulado de IA (SOLO QA) ────────────────────────────
# Con 1, el Ojo Experto contesta sin llamar a Google: se prueba el embudo
# entero —cupo, gasto, barrera de promesas, historial— sin gastar un centavo.
# ⚠️ NUNCA se enciende en producción aunque esta variable esté puesta:
# `VERCEL_ENV=production` manda sobre ella (lib/ia-simulada.ts). Copiar una
# variable de un entorno a otro es demasiado fácil, y la consecuencia sería que
# la app de las alumnas diera consejos inventados pareciendo sana.
AI_SIMULAR_IA=0
